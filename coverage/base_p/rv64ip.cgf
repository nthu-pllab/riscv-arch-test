        'leading_ones(xlen, ["rs1_val"], [xlen], 10)': 0
        'trailing_zeros(xlen, ["rs1_val"], [xlen], 12)': 0
        'trailing_ones(xlen, ["rs1_val"], [xlen], 13)': 0

rev16:
    config:
      - check ISA:=regex(.*I.*P.*Zicsr.*)
    mnemonics:
      rev16: 0
    rs1:
      <<: *all_regs
    rd:
      <<: *all_regs
    val_comb:
      abstract_comb:
        'simd_base_val("rs1", xlen, 16, signed=True)': 0

