cls:
    config: 
      - check ISA:=regex(.*I.*P)
    mnemonics: 
      cls: 0
    rs1: 
      <<: *all_regs
    rd: 
      <<: *all_regs
    op_comb: 
      <<: *ifmt_op_comb
    val_comb:
      abstract_comb:
        <<: [*rs1val_walking_unsgn]
        'leading_zeros(xlen, ["rs1_val"], [xlen], 11)': 0
        'leading_ones(xlen, ["rs1_val"], [xlen], 10)': 0
        'trailing_zeros(xlen, ["rs1_val"], [xlen], 12)': 0
        'trailing_ones(xlen, ["rs1_val"], [xlen], 13)': 0

abs:
    config: 
      - check ISA:=regex(.*I.*P)
    mnemonics: 
      abs: 0
    rs1: 
      <<: *all_regs
    rd: 
      <<: *all_regs
    op_comb: 
      <<: *ifmt_op_comb
    val_comb:
      abstract_comb:
        <<: [*rs1val_walking_unsgn]
        'leading_zeros(xlen, ["rs1_val"], [xlen], 11)': 0
        'leading_ones(xlen, ["rs1_val"], [xlen], 10)': 0
        'trailing_zeros(xlen, ["rs1_val"], [xlen], 12)': 0
        'trailing_ones(xlen, ["rs1_val"], [xlen], 13)': 0

rev:
    config: 
      - check ISA:=regex(.*I.*P)
    mnemonics: 
      rev: 0
    rs1: 
      <<: *all_regs
    rd: 
      <<: *all_regs
    op_comb: 
      <<: *ifmt_op_comb
    val_comb:
      abstract_comb:
